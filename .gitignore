# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Last synced: 2025-12-18
# License: CC0-1.0
#
# This template is maintained from the github/gitignore repository
# and distributed under Creative Commons Zero v1.0 Universal license.

# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/

# Editor-captured screenshots and shell crash dumps — scratch output, never source
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta
*.stackdump

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Asset Store content — bought, not authored here, and re-downloadable from the account that
# owns it. Together these are 3.7 GB against a 1 GB free LFS quota, so committing them would
# fail the push outright and make every clone a multi-gigabyte download, permanently.
# What to import, and at which version, is written down in docs/asset-store-packages.md.
# Note this ignores three specific folders, NOT all of Assets/Plugin — 09_shader is tracked.
/[Aa]ssets/[Pp]lugin/InnerverseInteractive/
/[Aa]ssets/[Pp]lugin/InnerverseInteractive.meta
/[Aa]ssets/[Pp]lugin/Lana Studio/
/[Aa]ssets/[Pp]lugin/Lana Studio.meta
/[Aa]ssets/[Pp]lugin/ToonScapes/
/[Aa]ssets/[Pp]lugin/ToonScapes.meta
/[Aa]ssets/[Pp]lugin/HAZE - Volumetric Fog & Lighting for URP/
/[Aa]ssets/[Pp]lugin/HAZE - Volumetric Fog & Lighting for URP.meta
/[Aa]ssets/[Pp]lugin/Handpainted_Grass_and_Ground_Textures/
/[Aa]ssets/[Pp]lugin/Handpainted_Grass_and_Ground_Textures.meta

# Arsip aset mentah beresolusi penuh. Di luar Assets supaya Unity tidak mengimpornya;
# di sini supaya tidak ikut membengkakkan repo. Tekstur 4K asli dan paket yang belum
# dipakai disimpan di sini kalau nanti perlu dipanggang ulang.
/_RawAssets/

# Paket VFX yang di-clone dari project_b ke Assets/Art/VFX/Packs/ — 403 MB .png/.fbx yang
# lewat LFS, alasan yang sama persis dengan lima paket di atas. Wrapper per skill di
# Assets/Art/VFX/Skills/ TETAP dilacak; dia yang memegang pilihan efek tiap skill.
# Cara mengembalikannya ada di docs/asset-store-packages.md.
/[Aa]ssets/[Aa]rt/VFX/Packs/GabrielAguiarProductions/
/[Aa]ssets/[Aa]rt/VFX/Packs/GabrielAguiarProductions.meta
/[Aa]ssets/[Aa]rt/VFX/Packs/JMO Assets/
/[Aa]ssets/[Aa]rt/VFX/Packs/JMO Assets.meta
/[Aa]ssets/[Aa]rt/VFX/Packs/Vefects/
/[Aa]ssets/[Aa]rt/VFX/Packs/Vefects.meta

# Berkas cadangan editor gambar (Krita/GIMP menulis "nama.png~" di sebelah aslinya).
*~

# Pack VFX vendor yang disalin dari project_b + Crimson (~1,5 GB).
# Sengaja TIDAK masuk git: repo ini tidak pakai LFS, dan menaruh 1,5 GB biner
# di riwayat berarti tiap clone menariknya selamanya. Sumbernya masih ada di
# D:\GameGamma\project_b\Assets\11_Plugin dan Crimson, jadi bisa disalin ulang.
Assets/Art/VFX/Packs/Cartoon Coffee/
Assets/Art/VFX/Packs/118 sprite effects bundle/
Assets/Art/VFX/Packs/Hovl Studio/
Assets/Art/VFX/Packs/Adrift Team/
Assets/Art/VFX/Packs/Cartoon Coffee.meta
Assets/Art/VFX/Packs/118 sprite effects bundle.meta
Assets/Art/VFX/Packs/Hovl Studio.meta
Assets/Art/VFX/Packs/Adrift Team.meta
